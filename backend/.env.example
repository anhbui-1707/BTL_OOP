# Reference only: Spring Boot does not automatically load this file.
SPRING_PROFILES_ACTIVE=dev
LINKIT_DB_HOST=localhost
LINKIT_DB_PORT=1433
LINKIT_DB_USERNAME=
LINKIT_DB_PASSWORD=
# Enable only for a local SQL Server using a self-signed certificate.
LINKIT_DB_TRUST_SERVER_CERTIFICATE=false
LINKIT_SERVER_PORT=8080
# Required: Base64 encoding of at least 32 cryptographically random bytes.
LINKIT_JWT_SECRET=
LINKIT_JWT_ISSUER=linkit
LINKIT_JWT_AUDIENCE=linkit-api
LINKIT_JWT_ACCESS_TTL=15m
LINKIT_JWT_REFRESH_TTL=30d
# Comma-separated exact origins; empty means no cross-origin browser access.
LINKIT_CORS_ALLOWED_ORIGINS=
